# Copy this file to .env and fill in your credentials.
# Never commit .env to version control (it is gitignored).

# ─── SMTP credentials ───────────────────────────────────────────────
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=587
EMAIL_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
EMAIL_USER=no-reply@yourdomain.com
EMAIL_PASS=your-mailbox-password

# ─── Where contact-form emails are delivered ────────────────────────
EMAIL_TO=customer.service@everlastwellness.com

# ─── Server port ────────────────────────────────────────────────────
PORT=5000

# ─── Google Sheets integration (optional) ───────────────────────────
# Deployed Google Apps Script Web App URL (see /google-apps-script/README.md).
# When set, each successful submission is also appended to the Google Sheet.
# Leave empty to disable — email still works exactly as before.
GOOGLE_SHEETS_WEBAPP_URL=
# Optional shared secret. If set, it MUST match SHARED_SECRET in the Apps
# Script Code.gs. Leave empty to disable the check.
GOOGLE_SHEETS_SECRET=

# ─── Canonical site URL ──────────────────────────────────────────────
# Used as the OAuth issuer and in confirmation-email links. Defaults to
# https://dermascope.ai if unset.
SITE_URL=https://dermascope.ai

# ─── OAuth 2.0 admin API (optional) ──────────────────────────────────
# Client credentials for the ONE admin client allowed to call
# GET /api/admin/submissions (see docs/oauth-admin-api.md). Leave both empty
# to disable the admin API entirely — every /oauth/token request will be
# rejected with 401 invalid_client.
OAUTH_ADMIN_CLIENT_ID=admin-dashboard
OAUTH_ADMIN_CLIENT_SECRET=

# ─── Operator sign-in (required for the auth.md claim ceremony) ──────
# The one login on this site — used only to confirm agent registrations at
# /claim (see docs/oauth-admin-api.md). POST /agent/identity is open (no auth
# on the call itself, per the auth.md spec), so nothing sensitive is granted
# until an operator signs in here and types the agent's 6-digit code.
OPERATOR_EMAIL=you@dermascope.ai
OPERATOR_PASSWORD=

# ─── OAuth signing key persistence (optional, recommended in production) ──
# Access tokens (1h) and claimed agents' identity_assertions (30 days) are
# both RS256-signed with this key. Left unset, a fresh key is generated every
# process start — fine for short-lived access tokens, but it also silently
# invalidates every identity_assertion on the next restart, forcing agents to
# repeat the claim ceremony. Set both to persist claimed identities across
# redeploys. Generate a pair with:
#   node -e "const{privateKey,publicKey}=require('crypto').generateKeyPairSync('rsa',{modulusLength:2048});console.log('OAUTH_SIGNING_PRIVATE_KEY_PEM='+privateKey.export({type:'pkcs8',format:'pem'}).trim().replace(/\n/g,'\\n'));console.log('OAUTH_SIGNING_PUBLIC_KEY_PEM='+publicKey.export({type:'spki',format:'pem'}).trim().replace(/\n/g,'\\n'));"
OAUTH_SIGNING_PRIVATE_KEY_PEM=
OAUTH_SIGNING_PUBLIC_KEY_PEM=

# ─── Web Bot Auth signing key persistence (optional, recommended in production) ──
# This site signs its one real outbound third-party request (the Google
# Sheets webhook, above) per Web Bot Auth (RFC 9421 HTTP Message Signatures),
# and publishes the matching public key at
# /.well-known/http-message-signatures-directory. Left unset, a fresh
# Ed25519 keypair is generated every process start, which changes the
# published `kid` on every restart — any receiving site that cached the old
# key can no longer verify signatures made with the new one. Set both to
# keep the same key (and `kid`) across redeploys. Generate a pair with:
#   node -e "const{privateKey,publicKey}=require('crypto').generateKeyPairSync('ed25519');console.log('WEB_BOT_AUTH_PRIVATE_KEY_PEM='+privateKey.export({type:'pkcs8',format:'pem'}).trim().replace(/\n/g,'\\n'));console.log('WEB_BOT_AUTH_PUBLIC_KEY_PEM='+publicKey.export({type:'spki',format:'pem'}).trim().replace(/\n/g,'\\n'));"
WEB_BOT_AUTH_PRIVATE_KEY_PEM=
WEB_BOT_AUTH_PUBLIC_KEY_PEM=
